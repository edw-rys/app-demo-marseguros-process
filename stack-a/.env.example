# Stack A — OCR local (Tesseract + PaddleOCR) + motor de reglas JSON
# Copiar a .env y ajustar. NUNCA commitear el .env.

# ── Seguridad ─────────────────────────────────────────────────────────────
# Bearer compartido con Laravel. Tiene que ser el MISMO valor que en
# admin/.env, stack-a/.env y stack-b/.env.
# Vacío desactiva la verificación (solo dev).
ANALYZER_TOKEN=demo-token-cambiar-en-produccion

# ── OCR tier 1: Tesseract ─────────────────────────────────────────────────
TESSERACT_CMD=/opt/homebrew/bin/tesseract
TESSERACT_LANG=spa+eng

# Umbral de caracteres extraídos por página para considerar que un PDF tiene
# capa de texto. Por debajo → ruta OCR (RF-04).
PDF_TEXT_MIN_CHARS=40

# Si la confianza media de Tesseract baja de este valor se reintenta con
# PaddleOCR (RF-04).
OCR_FALLBACK_THRESHOLD=60

# ── OCR tier 2: PaddleOCR ─────────────────────────────────────────────────
PADDLEOCR_ENABLED=true
PADDLEOCR_LANG=es

# ── Rasterizado de PDF ────────────────────────────────────────────────────
PDFTOPPM_CMD=/opt/homebrew/bin/pdftoppm
# Más DPI = mejor OCR pero más lento.
RASTER_DPI=300

# ── Reglas de clasificación ───────────────────────────────────────────────
# RF-05: score < 0.4 → "desconocido"
CLASSIFY_MIN_SCORE=0.4

# ── Varios ────────────────────────────────────────────────────────────────
MAX_TEXT_CHARS=200000
# Carpeta donde se escriben los `{archivo}.extracted.txt` para debug (RF-04).
TEXT_DUMP_DIR=