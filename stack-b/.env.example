# Stack B — OpenRouter + Gemini Flash Lite
# Copiar a .env y poner la key real. NUNCA commitear el .env.

# ── Seguridad ─────────────────────────────────────────────────────────────
# Bearer compartido con Laravel. Tiene que ser el MISMO valor que en
# admin/.env, stack-a/.env y stack-b/.env.
ANALYZER_TOKEN=demo-token-cambiar-en-produccion

# ── OpenRouter ────────────────────────────────────────────────────────────
# La key se saca de https://openrouter.ai/keys (formato sk-or-v1-...).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-lite
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── Parámetros de la llamada ──────────────────────────────────────────────
# temperature=0: el pipeline necesita respuestas reproducibles.
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SEC=30
LLM_MAX_RETRIES=2

# Precio por millón de tokens (USD) para calcular el costo en llm_calls (RF-10).
# Ajustar si se cambia de modelo; el costo real llega en la respuesta y manda
# sobre este valor cuando viene.
LLM_PRICE_PER_MTOK=0.14

# ── Clasificación ─────────────────────────────────────────────────────────
# RF-05: confianza < 0.5 → "desconocido"
CLASSIFY_MIN_CONFIDENCE=0.5

# RF-09: la respuesta al cliente no puede pasar de este largo.
REPLY_MAX_CHARS=800

# ── Cache y varios ────────────────────────────────────────────────────────
CACHE_ENABLED=true
MAX_TEXT_CHARS=60000