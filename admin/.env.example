APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ══════════════════════════════════════════════════════════════════════════
# Gmail Docs Validator — ver config/gmail_docs.php
# ══════════════════════════════════════════════════════════════════════════

# ── Google / Gmail ────────────────────────────────────────────────────────
# Ver docs/GOOGLE_CLOUD_SETUP.md, que explica las dos rutas posibles.
#
# service_account = Google Workspace + domain-wide delegation (requiere ser
#                   super-admin del dominio).
# oauth           = una cuenta propia, sin Workspace. Es lo que corresponde si
#                   lo que tenés es un @gmail.com: la delegación de dominio no
#                   existe fuera de Workspace.
GMAIL_AUTH_MODE=service_account

# ── service_account ───────────────────────────────────────────────────────
# El JSON de la service account NO va aquí: vive en storage/private/.
# Esta variable es solo su ruta.
GOOGLE_SERVICE_ACCOUNT_PATH=storage/private/service-account.json

# Usuario de dominio al que se delega la service account (domain-wide delegation).
GOOGLE_DELEGATED_USER=

# Buzones a vigilar, coma-separado. En modo oauth no se usa: la cuenta
# autorizada es la que se lee.
GOOGLE_MAILBOXES=

# ── oauth ─────────────────────────────────────────────────────────────────
# El client_id, el client_secret y el token tampoco van aquí: son archivos en
# storage/private/. Estas variables son solo sus rutas.
GOOGLE_OAUTH_CLIENT_PATH=storage/private/oauth-client.json
GOOGLE_OAUTH_TOKEN_PATH=storage/private/gmail-token.json

# Redirect URI registrado en Google Cloud. Tiene que coincidir carácter por
# carácter (puerto incluido) con el que vas a usar, o Google responde
# redirect_uri_mismatch. Vacío = se arma con APP_URL + /gmail/oauth/callback.
GOOGLE_OAUTH_REDIRECT_URI=

# ── Procesamiento ─────────────────────────────────────────────────────────
# Filtro de asunto: match parcial, coma-separado. Vacío = aceptar todo.
GMAIL_SUBJECT_FILTER=Trámite:,Solicitud,Renovación

# Remitente con el que se responde (vacío = el propio buzón vigilado).
GMAIL_REPLY_AS=

# false en demo: las respuestas se generan y se guardan, pero NO se envían.
# En modo oauth el scope es de solo lectura, así que además NO SE PODRÍA enviar.
GMAIL_SEND_ENABLED=false

# Polling automático de Gmail.
#
# Las lee `docker/supervisord.conf` (programa `gmail-poll`) al arrancar el
# contenedor, NO Laravel: es supervisord quien decide si existe el bucle. Por
# eso cambiarlas exige `docker compose restart admin`; un `optimize:clear` no
# alcanza.
#
# false deja el proceso vivo pero sin consultar nada. Está apagado por defecto
# acá para no gastar cuota de la API en un despliegue recién levantado que quizá
# no vaya a mirar el panel: con true el correo llega solo.
GMAIL_POLL_ENABLED=false

# Segundos entre vueltas. 300 = 5 minutos.
GMAIL_POLL_INTERVAL=300

# ── Workers Python ───────────────────────────────────────────────────────
# Stack con el que se procesa un job nuevo. B es el principal; A es el fallback.
DEFAULT_STACK=b

STACK_A_URL=http://127.0.0.1:8010
STACK_B_URL=http://127.0.0.1:8011

ANALYZER_TIMEOUT_SEC=60

# Bearer compartido con los dos workers. Tiene que ser el MISMO valor
# en admin/.env, stack-a/.env y stack-b/.env.
ANALYZER_TOKEN=

# ── Almacenamiento ────────────────────────────────────────────────────────
# Relativas a `storage/app`. Si empiezan por `/` se usan tal cual, que es lo
# que hace el `docker-compose` para montar un volumen compartido que Laravel y
# los dos workers Python ven en la MISMA ruta.
ATTACHMENTS_ROOT=attachments
DEMO_INBOX_PATH=demo-inbox
